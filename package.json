{
  "name": "@raphapetrereetapa/expo-file-opener",
  "version": "1.0.0",
  "description": "Expo module that opens a local file with the system \"Open with\" dialog (iOS and Android).",
  "main": "index.ts",
  "types": "index.ts",
  "files": [
    "index.ts",
    "expo-module.config.json",
    "ios",
    "android/build.gradle",
    "android/src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format": "prettier --write index.ts",
    "format-check": "prettier -c index.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RaphaPetrereEtapa/expo-file-opener.git"
  },
  "keywords": [
    "react-native",
    "expo",
    "expo-module",
    "file",
    "open-with",
    "share",
    "intent",
    "document-interaction"
  ],
  "license": "MIT",
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "expo-modules-core": "58.0.23",
    "prettier": "^3.6.2",
    "typescript": "~6.0.3"
  }
}
